  "query": "SELECT b.id, b.title, b.author, b.cover_path,\n                COUNT(ul.user_id) AS library_count\n         FROM books b\n         LEFT JOIN user_library ul ON b.id = ul.book_id\n         GROUP BY b.id\n         ORDER BY library_count DESC\n         LIMIT 5",
